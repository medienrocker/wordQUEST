# Eigene Richtlinie für das Admincenter.
#
# Sie ersetzt die Fassung aus dem Wurzelverzeichnis und ist an zwei Stellen
# strenger: script-src 'none', weil das Admincenter ohne JavaScript auskommt,
# und img-src ohne fremden Bildhost.
#
# Wichtig: form-action MUSS 'self' erlauben. Bei zwei CSP-Headern gilt die
# Schnittmenge, ein 'none' an irgendeiner Stelle blockt jedes Formular still.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'none'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Cache-Control "no-store"
</IfModule>
